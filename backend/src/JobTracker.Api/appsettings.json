{
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=jobtracker;Username=jobtracker;Password=jobtracker"
  },
  "Authentication": {
    "Issuer": "https://jobtracker.local",
    "Audience": "jobtracker-api",
    "SigningKey": "dev-only-signing-key-change-me-in-production-32b+",
    "TokenLifetimeMinutes": 60
  },
  "Outbox": {
    "PollingIntervalSeconds": 10,
    "BatchSize": 20
  },
  "OpenTelemetry": {
    "OtlpEndpoint": ""
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:3000"]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Hangfire": "Warning"
      }
    },
    "WriteTo": [{ "Name": "Console" }],
    "Enrich": ["FromLogContext"]
  },
  "AllowedHosts": "*"
}
